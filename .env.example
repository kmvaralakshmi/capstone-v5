# Copy this file to ".env" (same folder). Never share the real .env.
# ---------------------------------------------------------------------------
# LLM  (optional - the whole system also runs with NO LLM)
# ---------------------------------------------------------------------------
# auto   = OpenAI if OPENAI_API_KEY is set, else local Ollama if running, else none
# ollama = FREE and UNLIMITED, runs on your own PC (recommended while developing)
# openai | compatible (Groq, Gemini OpenAI endpoint, LM Studio, vLLM ...) | none
LLM_PROVIDER=auto
# Model name. Examples:  ollama -> qwen2.5:7b-instruct  or  llama3.1:8b
#                        openai -> any model available to your account
LLM_MODEL=
# Ollama default is http://localhost:11434/v1 (leave blank). For 'compatible' set both:
LLM_BASE_URL=
LLM_API_KEY=
# Only if you use OpenAI:
OPENAI_API_KEY=
LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Optional data sources
# ---------------------------------------------------------------------------
OPENAQ_API_KEY=
HTTP_TIMEOUT_SECONDS=25
